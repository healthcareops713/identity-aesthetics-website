# Security headers for every response served from the asset layer.
#
# HTML is served by Cloudflare's static-asset layer, which runs *before* the
# Worker, so the Worker cannot add these. This file is the supported way to set
# them. No Content-Security-Policy is declared here on purpose: the site loads
# Google Fonts and Google Translate and uses inline scripts, so a policy strict
# enough to be worth having needs to be built and tested deliberately rather
# than guessed at during launch week.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

# Content-hashed build output never changes, so it can be cached forever.
# This block reproduces the rule vinext generates: writing our own _headers
# replaces that generated file rather than merging with it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
